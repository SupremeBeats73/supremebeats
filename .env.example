# Copy to .env.local and fill in values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Replicate (MiniMax Music 1.5, etc.) — server-only
REPLICATE_API_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Playwright (e2e) — copy into .env.local; never commit real passwords.
# User must exist in Supabase Auth, email confirmed, and have enough credits for a beat job.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=
# Set to 0 to call the real /api/generate/music (needs REPLICATE_API_TOKEN and credits).
# E2E_MOCK_GENERATE_MUSIC=1
